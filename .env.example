# 服务端变量，在 Vercel Project Settings > Environment Variables 中配置。
DEEPSEEK_API_KEY=your_deepseek_api_key

# 可选，默认使用 deepseek-v4-flash。
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选。前端单独部署到其他域名时，用逗号分隔允许的完整 Origin。
ALLOWED_ORIGINS=https://your-static-site.example

# 可选。仅当前端与 API 分开部署时填写公开的代理地址。
VITE_CHAT_API_URL=https://your-api-domain.example/api/chat

# GitHub Pages 等纯静态版本使用。
VITE_ENABLE_AI_ASSISTANT=false
VITE_USE_HASH_ROUTER=true
